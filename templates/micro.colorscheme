# tui-shim managed. Palette: {{palette_name}}
color-link default "{{fg}},{{bg}}"
color-link comment "{{fg_dim}}"
color-link identifier "{{fg}}"
color-link constant "{{yellow_dark}}"
color-link statement "{{accent}}"
color-link symbol "{{fg}}"
color-link preproc "{{khaki_dark}}"
color-link type "{{khaki_dark}}"
color-link special "{{accent}}"
color-link error "bold {{accent}}"
color-link todo "bold {{yellow_dark}}"
color-link statusline "{{fg}},{{khaki}}"
color-link tabbar "{{fg}},{{bg_alt}}"
color-link line-number "{{hills_dark}},{{bg}}"
color-link current-line-number "{{accent}},{{bg}}"
color-link cursor-line "{{bg_alt}}"
color-link selection "{{fg}},{{khaki}}"
color-link gutter-error "{{accent}}"
color-link gutter-warning "{{yellow_dark}}"
